<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:cardCornerRadius="8dp"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <ImageView
                android:layout_weight="0.2"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:src="@drawable/add_red"/>

            <TextView
                android:id="@+id/bk_purpose"
                android:layout_weight="0.8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="For dream apps meeting"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </LinearLayout>

       <!-- approval authority-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtApproveAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approve Authority"
                android:textColor="@color/titan_theme_color"
                android:textStyle="bold"/>


            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/bk_chipGroup"
                app:singleLine="false"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                app:singleSelection="true"/>


        </LinearLayout>

<!--        room type-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Room Type "/>

            <TextView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text=" : "/>


            <TextView
                android:id="@+id/bk_roomtype"
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="6th floor meeting room "/>


        </LinearLayout>


        <!--        booking date-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Booking Date "/>

            <TextView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text=" : "/>


            <TextView
                android:id="@+id/bk_bookingdate"
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="23 oct,2024 "/>

        </LinearLayout>


<!--        start time-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Starting Time "/>

            <TextView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text=" : "/>


            <TextView
                android:id="@+id/bk_startTime"
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="09:00 am "/>

        </LinearLayout>

<!--        End time-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="End Time "/>

            <TextView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text=" : "/>


            <TextView
                android:id="@+id/bk_endTime"
                android:layout_weight="0.3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="11:00 am "/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_weight="0.7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:padding="2dp">

                <TextView
                    android:id="@+id/bk_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking Status : pending"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:background="#f7dcd3"
                    android:textColor="@color/titan_theme_color"
                    android:textStyle="bold"/>



            </androidx.cardview.widget.CardView>



        </LinearLayout>



    </LinearLayout>

</androidx.cardview.widget.CardView>