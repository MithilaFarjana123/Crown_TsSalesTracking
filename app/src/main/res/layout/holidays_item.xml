<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="8dp">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewItemSide"
            android:layout_weight="0.025"
            android:background="@color/titan_theme_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_weight="0.4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/titan_theme_color"
                android:text=""
                android:gravity="center"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtHolidayDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="14"
                android:textSize="25sp"
                android:gravity="center"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:layout_weight="0.01"
            android:background="@color/gray_four"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>


        <TextView
            android:id="@+id/txtHolidayInfo"
            android:layout_weight="0.7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textColor="@color/titan_theme_color"
            android:gravity="center"
            android:textStyle="bold"
            android:padding="5dp"
            android:text="Durga Puja"/>


    </LinearLayout>


</androidx.cardview.widget.CardView>