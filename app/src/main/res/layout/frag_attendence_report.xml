<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Fragment.Frag_AttendenceReport">


    <LinearLayout
        android:background="@drawable/bg_titan"
        android:layout_marginTop="56dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

<!--        header-->

        <LinearLayout
            android:layout_marginBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/attendenceUserImg"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="0.2"
                    android:src="@drawable/ic_user_profile" />

                <LinearLayout
                    android:layout_weight="0.8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginRight="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtEMPName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text=""
                        android:textColor="#898583"
                        android:gravity="end"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEMPDEsignation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#898583"
                        android:text=""
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/txtAttDept"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:gravity="end"
                        android:textColor="#898583"
                        android:textSize="12sp" />

                </LinearLayout>





            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/border_gray"
                android:orientation="horizontal">

                <TextView
                    android:layout_weight="0.08"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_weight="0.1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Month-Year"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="start"/>

                <TextView
                    android:layout_weight="0.08"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="In"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_weight="0.1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Out"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="center"/>



                <TextView
                    android:layout_weight="0.08"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="center"/>


            </LinearLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_att_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        layout="@layout/shimmer_att_report" />

                    <include
                        layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                    <include layout="@layout/shimmer_att_report" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/att_item" />


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/txtAttNoData"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/nodata" />


        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/searchFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="20dp"
        android:contentDescription="TODO"
        android:src="@drawable/baseline_search_24"
        app:backgroundTint="@color/titan_theme_color"
        app:tint="@color/white" />


</FrameLayout>