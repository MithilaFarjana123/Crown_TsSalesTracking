<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:cardCornerRadius="3dp"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginTop="15dp"
    android:layout_marginBottom="20dp">

    <LinearLayout
        android:id="@+id/layoutItemNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">


    <TextView
        android:id="@+id/lv_type"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:padding="3dp"
        android:textSize="15sp"
        android:background="#fdf9ff"
        android:text="Casual"/>



    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:background="#eff8ef"
            android:orientation="vertical">


            <TextView
                android:layout_marginLeft="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#898583"
                android:text="Remain"/>


            <TextView
                android:id="@+id/lv_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:gravity="center"
                android:text=" "/>



        </LinearLayout>



        <LinearLayout
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:background="#ffeef1"
            android:orientation="vertical">

            <TextView
                android:layout_marginLeft="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#898583"
                android:text="Enjoyed"/>


            <TextView
                android:id="@+id/lv_enjoyed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:text=" "/>



        </LinearLayout>





    </LinearLayout>


    </LinearLayout>



</androidx.cardview.widget.CardView>