                                    android:layout_height="0dp"
                                    android:layout_marginBottom="5dp"
                                    android:layout_weight="1"
                                    android:hint="End Time"
                                    app:startIconDrawable="@drawable/ic_grid_white">

                                    <AutoCompleteTextView
