<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="56dp"
    tools:context=".UI.Fragment.Frag_Engineer_Add_Update">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="5dp"
            android:background="#CCCCCC"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/engSbp"
                android:layout_weight="0.4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:text="SBP "/>



            <TextView
                android:id="@+id/createDate"
                android:layout_weight="0.6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:gravity="right"
                android:text="date "/>


        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.35" />




            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgUserName"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="0.5"
                android:src="@drawable/ic_user_profile"
                app:civ_border_color="#CCCCCC"
                app:civ_border_width="1dp" />

            <!--            <ImageView-->
            <!--                android:id="@+id/imgUserName"-->
            <!--                android:layout_width="0dp"-->
            <!--                android:layout_height="150dp"-->
            <!--                android:layout_weight="0.5"-->
            <!--                android:scaleType="fitXY"-->
            <!--                android:src="@drawable/ic_user_gray" />-->

            <ImageView
                android:id="@+id/imgSelectImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:layout_marginLeft="-20dp"
                android:layout_weight="0.1"
                android:src="@drawable/ic_baseline_add_a_photo" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

             <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/half_curved"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEnName"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:boxStrokeErrorColor="@color/orange"
                app:endIconMode="clear_text"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/ic_user_gray">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtEnName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:hint="Engineer Name  (as per NID)" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEnDesi"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:boxStrokeErrorColor="@color/orange"
                app:endIconMode="clear_text"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/ic_brand_brand">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtEnDesi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:hint="Designation"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNIDNUm"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:boxStrokeErrorColor="@color/orange"
                app:endIconMode="clear_text"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/ic_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtNIDNUm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:hint="NID Number"/>
            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="7dp"
                android:text=""
                android:textSize="12sp" />

        </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:background="#CCCCCC"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"
                                android:padding="5dp"
                                android:src="@drawable/ic_user_gray" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:padding="8dp"
                                android:text="Engineer Information"
                                android:textColor="#000000"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                        <!--organization-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEnOrga"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_business">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEnOrga"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:hint="Organization/Consulting firm name"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <!--adderss-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEAdd"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_home">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEnOAdd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:hint="Details office address"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!--party mobile-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEMo"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_smartphone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEnMobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:digits="0123456789"
                                android:hint="Mobile"
                                android:inputType="phone"
                                android:maxLength="11"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <!--party mobile 2-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutE2Mo"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_smartphone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEn2Mobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:digits="0123456789"
                                android:hint="Alternative Mobile"
                                android:inputType="phone"
                                android:maxLength="11"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <!--Party email-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_email_color">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEPartyEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:hint="Email" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ongoing|crown site-->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:orientation="horizontal">
                            <!--ongoing site-->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutEOngoing"
                                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxStrokeErrorColor="@color/orange"
                                app:endIconMode="clear_text"
                                app:errorIconTint="@color/orange"
                                app:errorTextColor="@color/orange"
                                app:startIconDrawable="@drawable/ic_number">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtEOngoing"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@color/transparent"
                                    android:digits="0123456789"
                                    android:hint="Ongoing Site"
                                    android:inputType="number"
                                    android:singleLine="true" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.01"
                                android:background="#CCCCCC" />

                            <!--crown site-->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutECrown"
                                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:boxStrokeErrorColor="@color/orange"
                                app:endIconMode="clear_text"
                                app:errorIconTint="@color/orange"
                                app:errorTextColor="@color/orange"
                                app:startIconDrawable="@drawable/ic_number">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtECrown"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@color/transparent"
                                    android:digits="0123456789"
                                    android:hint="Crown Site"
                                    android:inputType="number"
                                    android:singleLine="true" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <!--DOB-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEDOB"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_calendar">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtEDOB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:focusable="false"
                                android:hint="Date of birth"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!--MDay-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutMAn"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_calendar">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtMDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:focusable="false"
                                android:hint="Marriage Anniversary"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <!--Category-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutEnCat"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:hint="Engineer Category"
                            app:boxStrokeErrorColor="@color/orange"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_outline_doc">

                            <AutoCompleteTextView
                                android:id="@+id/acECategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_margin="10dp"
                            android:background="#CCCCCC" />

                        <TextView
                            android:layout_width="match_parent"

                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:gravity="center"
                            android:text="Top Three Recommended Brand"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_margin="10dp"
                            android:background="#CCCCCC" />

                        <!--BRAND1-->
                        <AutoCompleteTextView
                            android:id="@+id/txtEBrand1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:drawableLeft="@drawable/ic_baseline_one_gray"
                            android:gravity="center"
                            android:hint="Recommended Brand One"
                            android:padding="15dp"
                            android:textColorHint="#787171"
                            android:textSize="12sp" />

                        <!--BRAND2-->
                        <AutoCompleteTextView
                            android:id="@+id/txtEBrand2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:drawableLeft="@drawable/ic_two_gray"
                            android:gravity="center"
                            android:hint="Recommended BrandBrand Two"
                            android:padding="15dp"
                            android:textColorHint="#787171"
                            android:textSize="12sp" />

                        <!--BRAND3-->
                        <AutoCompleteTextView
                            android:id="@+id/txtEBrand3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:drawableLeft="@drawable/ic_number_three_gray"
                            android:gravity="center"
                            android:hint="Recommend Brand Three"
                            android:padding="15dp"
                            android:textColorHint="#787171"
                            android:textSize="12sp" />


                        <!--Remarks-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutERemarks"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_baseline_remarks">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtERemarks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/transparent"
                                android:hint="Remarks"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!--Card Image-->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="10dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:background="#CCCCCC"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"
                                android:padding="5dp"
                                android:src="@drawable/image_placeholder" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.6"
                                android:padding="8dp"
                                android:text="Add Visiting Card"
                                android:textColor="#000000"
                                android:textSize="20sp"
                                android:textStyle="bold" />




                            <ImageView
                                android:id="@+id/imgAddVisiting"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"
                                android:padding="5dp"
                                android:src="@drawable/add_image" />

                            <!--                            <ImageView-->
                            <!--                                android:id="@+id/pdfAddVisiting"-->
                            <!--                                android:layout_width="0dp"-->
                            <!--                                android:layout_height="match_parent"-->
                            <!--                                android:layout_weight="0.1"-->
                            <!--                                android:padding="5dp"-->
                            <!--                                android:src="@drawable/ic_add_pdf" />-->


                            <ImageView
                                android:id="@+id/addCamera"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.1"
                                android:padding="5dp"
                                android:src="@drawable/ic_baseline_photo_camera" />

                        </LinearLayout>



                        <ImageView
                            android:id="@+id/imgSetVisitingImage"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:scaleType="fitXY" />

                        <TextView
                            android:id="@+id/txtPdfName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEngineer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Submit"
                    android:textColor="@color/titan_theme_color"
                    app:cornerRadius="0dp"
                    app:strokeColor="@color/titan_theme_color" />

            </LinearLayout>

    </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>



</FrameLayout>