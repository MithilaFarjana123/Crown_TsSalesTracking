<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Fragment.Frag_Demo_Customer_Home">

    <LinearLayout
        android:layout_marginTop="56dp"
        android:paddingBottom="70dp"
        android:background="@drawable/bg_titan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_weight="0.5"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgVerified"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:layout_marginTop="-160dp"
                android:layout_marginBottom="120dp"
                android:src="@drawable/ic_verified"
                android:visibility="gone" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/locationStatus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="start"
                android:layout_marginTop="-160dp"
                android:layout_marginBottom="120dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:visibility="gone"
                app:lottie_rawRes="@raw/live"/>

            <ImageView
                android:id="@+id/imgRetailerHomeCover"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="fitXY"
                android:src="@drawable/party_banner"/>

            <ImageView
                android:id="@+id/imgRetailerSetCover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="-80dp"
                android:layout_marginBottom="50dp"
                android:clickable="true"
                android:src="@drawable/ic_camera_cover"
                tools:ignore="SpeakableTextPresentCheck,ImageContrastCheck,TouchTargetSizeCheck" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#ebedef"/>

        </LinearLayout>

        </LinearLayout>

       <LinearLayout
                android:layout_weight="0.5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:orientation="horizontal"
                android:paddingTop="15dp"
                android:background="#ebedef"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_weight="0.2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        

                    <TextView
                        android:id="@+id/txtShopName"
                        android:layout_weight="0.8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Testing Party"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <ImageView
                        android:id="@+id/callIcon"
                        android:layout_weight="0.2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:src="@drawable/call"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    </LinearLayout>


                    <TextView
                        android:id="@+id/txtShopOwner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Propitor: ABdul Hamid Khan"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Address: East Goran, Khilgaon Dhaka 1219"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/txtShopMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Mobile: +8801234565443"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/txtShopCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Code: Re-123455"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/txtResponsiblePerson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Responsible Person: "
                        android:layout_marginTop="10dp"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/txtResponsiblePerNum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#616A6B"
                        android:text="Responsible Person's Number : "
                        android:textSize="14sp" />


                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.2"
                    android:padding="5dp"
                    android:src="@drawable/default_user_image"
                    android:visibility="gone" />


            </LinearLayout>



        </LinearLayout>



        <!--    bottompart-->


