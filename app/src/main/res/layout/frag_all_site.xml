<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="56dp"
    tools:context=".UI.Fragment.Frag_All_Site">


    <LinearLayout
        android:paddingBottom="60dp"
        android:background="@drawable/bg_titan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="5dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/partyname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/black"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:padding="5dp"
                            android:text=" Total Site "
                            android:textColor="@color/titan_theme_color"
                            android:textSize="16sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/totalMason"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:drawableLeft="@drawable/ic_sum"
                            android:padding="5dp"
                            android:text=" :  "
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />



                </LinearLayout>




                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/green"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/white"/>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/titan_theme_color"/>



            </LinearLayout>


        </androidx.cardview.widget.CardView>



        <androidx.appcompat.widget.SearchView
        android:id="@+id/search_allsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:background="#CFCFCF"
        android:text="Search your site"
        android:textCursorDrawable="@null"
        app:iconifiedByDefault="false"
        app:queryBackground="@null" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rdDemoAllSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        tools:listitem="@layout/demo_site_item" />
    </LinearLayout>



    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddNewSite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="12dp"
        android:contentDescription="TODO"
        android:text="Add NEW"
        android:textColor="@color/white"
        app:backgroundTint="@color/titan_theme_color"
        app:icon="@drawable/ic_baseline_add"
        app:iconTint="@color/white"
        app:tint="@color/white" />



</FrameLayout>