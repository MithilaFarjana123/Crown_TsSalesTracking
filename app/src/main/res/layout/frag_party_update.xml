<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Fragment.Frag_Party_Update">


    <LinearLayout
        android:layout_marginTop="56dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_margin="10dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <ImageView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/gray_three"
                android:src="@drawable/ic_user"/>

                <TextView
                    android:layout_weight="0.5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Party Information"
                    android:padding="5dp"
                    android:background="@color/gray_three"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/party_code"
                    android:layout_weight="0.5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:padding="5dp"
                    android:background="@color/gray_three"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>



            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="horizontal">



                <LinearLayout
                    android:layout_weight="0.4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1" />


                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/resizeImage"
                        android:layout_weight="0.01"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:contentDescription="TODO"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/orange"
                        app:icon="@drawable/baseline_restart"
                        app:iconTint="@color/white"
                        app:tint="@color/white" />



                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgSetOtherPartyImage"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.5"
                        android:src="@drawable/ic_baseline_account_circle"
                        app:civ_border_color="#CCCCCC"
                        app:civ_border_width="1dp" />



                    <ImageView
                        android:id="@+id/imgAddOtherCover"
                        android:layout_width="29dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|bottom"
                        android:layout_marginLeft="-30dp"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_baseline_camera" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_weight="0.6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutOName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_baseline_person_pin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtONAme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:hint="Name " />
                    </com.google.android.material.textfield.TextInputLayout>



                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutOMo"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_baseline_smartphone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtOMobile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:digits="0123456789"
                            android:hint="Mobile Number"
                            android:editable="false"
                            android:inputType="phone"
                            android:maxLength="11"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutNIDNum"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_id">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtNIDNum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:digits="0123456789"
                            android:hint="NId Number"
                            android:inputType="phone"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutOAdd"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_baseline_business">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtOAdd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/transparent"
                            android:hint="Address"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>




                </LinearLayout>




            </LinearLayout>


            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        android:layout_margin="10dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/gray_three"
                android:src="@drawable/ocupation"/>

            <TextView
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Party Occupation"
                android:padding="5dp"
                android:background="@color/gray_three"
                android:textStyle="bold"
                android:textColor="@color/black"/>


            <TextView
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=" "
                android:padding="5dp"
                android:background="@color/gray_three"
                android:textStyle="bold"
                android:textColor="@color/black"/>



        </LinearLayout>



        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOOccupation"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:boxStrokeErrorColor="@color/orange"
            app:endIconMode="clear_text"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            android:layout_marginBottom="10dp"
            app:startIconDrawable="@drawable/ic_baseline_work">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtOccupation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Occupation" />
        </com.google.android.material.textfield.TextInputLayout>


    </LinearLayout>

    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        android:layout_margin="10dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">



            <ImageView
                android:layout_weight="0.1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/gray_three"
                android:src="@drawable/responsible_person"/>

            <TextView
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Responsible Details"
                android:padding="5dp"
                android:background="@color/gray_three"
                android:textStyle="bold"
                android:textColor="@color/black"/>


            <TextView
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=" "
                android:padding="5dp"
                android:background="@color/gray_three"
                android:textStyle="bold"
                android:textColor="@color/black"/>



        </LinearLayout>




        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOResPerson"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:boxStrokeErrorColor="@color/orange"
            app:endIconMode="clear_text"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            app:startIconDrawable="@drawable/ic_baseline_co_present">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtOResPerson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Responsible Person" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOResPersonMo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:boxStrokeErrorColor="@color/orange"
            app:endIconMode="clear_text"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            app:startIconDrawable="@drawable/ic_baseline_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtOResPersonMo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:editable="false"
                android:inputType="phone"
                android:maxLength="11"
                android:digits="0123456789"
                android:singleLine="true"
                android:hint="Responsible Person's Mobile Number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOResPersonRtn"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:hint="Relation with H/W"
            app:boxStrokeErrorColor="@color/orange"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            android:layout_marginBottom="10dp"
            app:startIconDrawable="@drawable/hw_relation">

            <AutoCompleteTextView
                android:id="@+id/acOResPersonRtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false" />


        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/txtTSOtherArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

    </androidx.cardview.widget.CardView>





        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateParty"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:text="Update party"
            app:cornerRadius="0dp"
            android:textColor="@color/titan_theme_color"
            app:strokeColor="@color/titan_theme_color" />

        </LinearLayout>


        </ScrollView>




    </LinearLayout>



</FrameLayout>