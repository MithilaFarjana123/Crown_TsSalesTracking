<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/titan_theme_color"
        android:orientation="horizontal">

        <View
            android:layout_weight="0.2"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>

        <TextView
            android:layout_weight="0.8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="5dp"
            android:text="Confirm Quick Visit"/>


        <ImageView
            android:id="@+id/qVisit_close"
            android:layout_weight="0.2"
            android:layout_width="0dp"
            android:src="@drawable/cancel_white"
            android:layout_height="match_parent"/>


    </LinearLayout>



    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="20dp"
        android:src="@drawable/ic_quick_visit_offline"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="5dp"
        android:text="Do you want to add this site in your quick visit?"/>



    <LinearLayout
        android:layout_marginBottom="20dp"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_weight="0.2"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/qvisit_cancel"
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:padding="5dp"
            android:background="@color/gray_two"
            android:text="Cancel"/>

        <View
            android:layout_weight="0.2"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/qvisit_confirm"
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@color/titan_theme_color"
            android:padding="5dp"
            android:text="Confirm"/>

        <View
            android:layout_weight="0.2"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>




    </LinearLayout>

</LinearLayout>