                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCallRDisTopic"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:hint="Discussion Topic"
                        app:endIconMode="clear_text"
                        app:boxStrokeErrorColor="@color/orange"
                        app:errorIconTint="@color/orange"
                        app:startIconDrawable="@drawable/ic_client_type_gray"
                        app:errorTextColor="@color/orange">


                        <com.google.android.material.textfield.TextInputEditText
                            android:editable="false"
                            android:id="@+id/txtCallRDisTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>


                    </com.google.android.material.textfield.TextInputLayout>



                    <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRSiteSiteAddTopic"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:boxStrokeErrorColor="@color/orange"
                app:endIconMode="clear_text"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/ic_reason">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtRSiteAddTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Additional Topic" />
            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRCallConStatus"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:hint="Convertion Status"
                app:boxStrokeErrorColor="@color/orange"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/ic_status">

                <AutoCompleteTextView
                    android:id="@+id/acRCallConversionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false" />

            </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRCallConSiteStatus"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:hint="Site Status"
                        app:boxStrokeErrorColor="@color/orange"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_building">

                        <AutoCompleteTextView
                            android:id="@+id/acRCallSiteStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false" />

                    </com.google.android.material.textfield.TextInputLayout>



            <LinearLayout
                android:id="@+id/RconYes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRCallClientType"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Comment Type"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_grid_white">

                    <AutoCompleteTextView
                        android:id="@+id/acRCallCementType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>




                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRdeliveryOrderQuantity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_delivery">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtRdeliveryOrderQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="Delivery order Quantity" />
                </com.google.android.material.textfield.TextInputLayout>





                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRCallDeliveryDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:endIconMode="clear_text"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/baseline_calendar_month_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtRCallDeliveryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="Delivery date" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRPartSiteResPerson"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_responsible_person">

                    <AutoCompleteTextView
                        android:id="@+id/txtRPartSiteResPerson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="11"
                        android:singleLine="true"
                        android:digits="E-0123456789"
                        android:hint="Responsible Trade Sales Person's Emp" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/RconNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRSiteNoAchReason"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Reason of No Achievement"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_reason">

                    <AutoCompleteTextView
                        android:id="@+id/acRSiteNoAchReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/RconBeforeConverted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">



                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRdeliveryQuantity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_delivery">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtRdeliveryQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="Delivery Quantity" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTRBeforeCondate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:endIconMode="clear_text"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/baseline_calendar_month_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtReforeCondate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:hint="Delivery Date" />
                </com.google.android.material.textfield.TextInputLayout>



                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRCallFollowUp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Follow up reason"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_status">

                    <AutoCompleteTextView
                        android:id="@+id/acRCallFollowUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>



            </LinearLayout>



                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRdeliverydealerCode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/baseline_business_center_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtRdeliveryQuantitydealerCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Dealer Code" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutRdeliveryRetailerCode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        app:boxStrokeErrorColor="@color/orange"
                        app:endIconMode="clear_text"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/retailer">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtRdeliveryQuantityRetailerCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Retailer Code" />
                    </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRCallNextVisit"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                app:endIconMode="clear_text"
                app:errorIconTint="@color/orange"
                app:errorTextColor="@color/orange"
                app:startIconDrawable="@drawable/baseline_calendar_month_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtRCallNextVisit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:hint="Next visit Date" />
            </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavedemoRCallRecord"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Submit Call Record"
                    app:cornerRadius="0dp"
                    android:textColor="@color/titan_theme_color"
                    app:strokeColor="@color/titan_theme_color" />


            </LinearLayout>


            </ScrollView>

        </LinearLayout>






    </LinearLayout>






</FrameLayout>