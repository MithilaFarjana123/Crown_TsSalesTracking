<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtLVDetails"
            android:layout_weight="0.9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Leave Details"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="5dp"
            android:background="@color/titan_theme_color"
            android:textColor="@color/white"/>

    </LinearLayout>




    <TextView
        android:id="@+id/txtLVApplicationNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:text="Application No. : LVT-118669"/>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:background="#ccd1d1"
        />


    <TextView
        android:id="@+id/txtApproveAuth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approve Authority"
        android:layout_margin="10dp"
        android:textColor="@color/titan_theme_color"
        android:textStyle="bold"/>

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/chipGroup"
        app:singleLine="false"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        app:singleSelection="true"/>

    <TextView
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending To"
        android:layout_margin="10dp"
        android:textColor="@color/titan_theme_color"
        android:textSize="12sp" />


    <TextView
        android:id="@+id/txtApprovePending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text=""
         />


    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="#ccd1d1"/>

        <LinearLayout
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#ccd1d1"/>

            <LinearLayout
                android:layout_weight="0.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leave Type"
                    android:textStyle="bold"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Application"
                    android:drawableLeft="@drawable/baseline_camera_24"
                    android:padding="5dp"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                     />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leave Purpose"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:padding="5dp"
                    android:drawableLeft="@drawable/baseline_app_registration_24"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address During Leave"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:drawableLeft="@drawable/ic_baseline_address"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leave Status"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Application"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:drawableLeft="@drawable/ic_status"
                    android:textColor="@color/black"
                    />




            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#ccd1d1"/>

            <LinearLayout
                android:layout_weight="0.5"
                android:layout_margin="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="From Date"
                    android:textStyle="bold"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVFromDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:drawableLeft="@drawable/ic_baseline_date_color"
                    android:padding="5dp"
                    android:textSize="14sp"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="To Date"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVToDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:padding="5dp"
                    android:drawableLeft="@drawable/ic_baseline_date_color"
                    android:textSize="14sp"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Days"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/titan_theme_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLVTotalDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:padding="5dp"
                    android:drawableLeft="@drawable/ic_total_days"
                    android:textSize="14sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#ccd1d1"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ccd1d1"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="5dp"/>


    </LinearLayout>













</LinearLayout>