<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.Fragment.Frag_Calender">


    <LinearLayout
        android:layout_marginTop="54dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.prolificinteractive.materialcalendarview.MaterialCalendarView
                android:id="@+id/holidayView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:mcv_dateTextAppearance="@style/CalendarViewTextAppearance"
                app:mcv_firstDayOfWeek="saturday"
                app:mcv_headerTextAppearance="@style/CalendarViewWeekDayTextAppearance"
                app:mcv_selectionColor="@color/crown_icon_color"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Holiday Info"
            android:layout_marginLeft="14dp"/>


        <View
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHoliday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            tools:listitem="@layout/holidays_item"/>

        <androidx.cardview.widget.CardView
            android:visibility="gone"
            android:id="@+id/noCard"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="10dp"
            app:cardElevation="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sorry, No holiday declare yet."
                android:layout_gravity="center"
                android:gravity="center"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>