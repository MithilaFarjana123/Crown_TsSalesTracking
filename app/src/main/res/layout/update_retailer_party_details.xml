<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:background="#CCCCCC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.1"
            android:padding="5dp"
            android:src="@drawable/ic_retailer_details" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:padding="8dp"
            android:textStyle="bold"
            android:text="Retailer details info"
            android:textColor="#000000"
            android:textSize="20sp" />

    </LinearLayout>
    <!--Party Address-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_baseline_home">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:id="@+id/txtPartyAdd2"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Party Address 2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_calendar">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:id="@+id/txtPartyOpenDate"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Party Open Date" />
    </com.google.android.material.textfield.TextInputLayout>
    <!-- Contact Person-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        android:visibility="gone"
        app:startIconDrawable="@drawable/ic_user_gray">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:id="@+id/txtContactPerson"
            android:background="@android:color/transparent"
            android:hint="Contact Person" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_outline_user">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:id="@+id/txtEntryUser"
            android:background="@android:color/transparent"
            android:hint="Entry User" />
    </com.google.android.material.textfield.TextInputLayout>
    <!--Email-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_email_color">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:id="@+id/txtContactEmail"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Party Email" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        android:visibility="gone"
        app:startIconDrawable="@drawable/ic_baseline_admin">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:id="@+id/txtContactDesi"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Contact Designation" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--Dealer Code-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_number">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:id="@+id/txtDealerCode"
            android:background="@android:color/transparent"
            android:hint="Dealer Code" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_status">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:id="@+id/txtOutletStatus"
            android:background="@android:color/transparent"
            android:hint="Outlet Status" />
    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_route">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:id="@+id/txtRouteName"
            android:background="@android:color/transparent"
            android:hint="Route Name" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        android:id="@+id/layoutRESAPCode"
        app:startIconDrawable="@drawable/sap_code">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:id="@+id/txtReSAPCode"
            android:digits="0123456789"
            android:inputType="number"
            android:background="@android:color/transparent"
            android:hint="SAP Code" />
    </com.google.android.material.textfield.TextInputLayout>


</LinearLayout>