<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.Fragment.Frag_Paymen_Collection_Save">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="60dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:paddingBottom="30dp"
        app:cardCornerRadius="8dp">

        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBankImage"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"/>

                <!--Payment Date-->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtPaymentDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:focusable="false"
                        android:hint="Payment Date" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--Bank Name-->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBank"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    android:hint="Bank Name"
                    app:startIconDrawable="@drawable/ic_baseline_home">

                    <AutoCompleteTextView
                        android:id="@+id/acBankName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!--Branch-->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBranch"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    android:hint="Branch"
                    app:startIconDrawable="@drawable/ic_district">

                    <AutoCompleteTextView
                        android:id="@+id/acBranchName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>

<!--                app:cardBackgroundColor="#F8F8F8"-->
                <androidx.cardview.widget.CardView

                    app:cardElevation="8dp"
                    app:cardCornerRadius="8dp"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:paddingBottom="10dp"
                        android:layout_margin="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!--Party Name-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_retailer_details">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtCustomerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:focusable="false"
                                android:enabled="false"
                                android:hint="Payment From" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!--Payment To-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"

                            app:endIconMode="clear_text"
                            app:boxStrokeErrorColor="@color/orange"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_client_type">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtPaymentTo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:focusable="false"
                                android:enabled="false"
                                android:hint="Payment To" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!--Routing No-->

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_number">

                        </com.google.android.material.textfield.TextInputLayout>

                        <!--Account No-->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            app:boxStrokeErrorColor="@color/orange"
                            app:endIconMode="clear_text"
                            app:errorIconTint="@color/orange"
                            app:errorTextColor="@color/orange"
                            app:startIconDrawable="@drawable/ic_account">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtAccountNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:focusable="false"
                                android:enabled="false"
                                android:hint="Account No." />
                        </com.google.android.material.textfield.TextInputLayout>



                    </LinearLayout>


                </androidx.cardview.widget.CardView>



                <!--Payment Type-->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPayType"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Payment Type"
                    app:boxStrokeErrorColor="@color/orange"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_payment_method">

                    <AutoCompleteTextView
                        android:id="@+id/acPayType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false" />

                </com.google.android.material.textfield.TextInputLayout>


                <!--Remarks-->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    android:id="@+id/layoutDocumentNo"
                    app:startIconDrawable="@drawable/ic_outline_doc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtDocumentNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Document No" />
                </com.google.android.material.textfield.TextInputLayout>





                <!--Amount-->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:id="@+id/layoutCollectionAmount"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_taka_bd">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:digits=".0123456789"
                        android:hint="Amount"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--Remarks-->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:boxStrokeErrorColor="@color/orange"
                    app:endIconMode="clear_text"
                    app:errorIconTint="@color/orange"
                    app:errorTextColor="@color/orange"
                    app:startIconDrawable="@drawable/ic_baseline_remarks">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtCollectionRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Deposit Details" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:layout_weight="0.9"
                                android:text="Sample Document"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/imgAddImage"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10dp"
                                android:layout_weight="0.1"
                                android:src="@drawable/ic_baseline_add_a_photo" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#CCCCCC" />

                        <ImageView
                            android:id="@+id/imgCapturedImage"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:scaleType="fitXY" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnCollectionSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginBottom="10dp"
                    android:paddingBottom="10dp"
                    android:text="Submit" />

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/txtRoutingNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:enabled="false"
        android:focusable="false"
        android:hint="Routing No" />

</FrameLayout>