<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="56dp"
    tools:context=".UI.Fragment.Frag_TeamLead_CallRecord">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/siteImg"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/site_icon"
                android:layout_margin="5dp"/>


        </LinearLayout>



    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="Verification Information"
            android:textSize="15sp"
            android:background="@color/gray_three"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/black"/>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutVerificationInfo"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:boxStrokeErrorColor="@color/orange"
            app:endIconMode="clear_text"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            app:startIconDrawable="@drawable/baseline_search_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtVerificationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:gravity="center"
                android:hint="Verification Details" />
        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:backgroundTint="@color/titan_theme_color"
            android:textStyle="bold"
            android:text="Verify"/>





    </LinearLayout>


    </androidx.cardview.widget.CardView>



    </LinearLayout>




</FrameLayout>