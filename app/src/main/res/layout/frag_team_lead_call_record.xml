        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:stretchColumns="1">

                        <TableRow android:paddingBottom="8dp">

                            <TextView
                                android:text="First Delivery : "
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFirstDelivery"
                                android:text=" 2026-01-10 (Qty: 50)" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">

                            <TextView
                                android:text="Last Delivery : "
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/tvLastDelivery"
                                android:text=" 2026-04-12 (Qty: 30)" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">

                            <TextView
                                android:text="Engineer:"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEngineer"
                                android:text=" Engineer X" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">

                            <TextView
                                android:text="Contractor:"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvContractor"
                                android:text=" Contractor y" />
                        </TableRow>

<!--                        <TableRow android:paddingBottom="8dp">-->

<!--                            <TextView-->
<!--                                android:text="Retailer:"-->
<!--                                android:textStyle="bold" />-->

<!--                            <TextView-->
<!--                                android:id="@+id/tvRetailer"-->
<!--                                android:text=" Retailer z" />-->
<!--                        </TableRow>-->


                    </TableLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Verification Status" />

                <Spinner
                    android:id="@+id/spinnerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:entries="@array/verification_options" />

                <LinearLayout
                    android:id="@+id/layoutMismatchFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Actual Delivery Date"
                        app:startIconDrawable="@drawable/ic_calendar"> <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etActualDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Actual Quantity">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etActualQty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEngineerCode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Site referred by"
                        app:boxStrokeErrorColor="@color/orange"
                        app:errorIconTint="@color/orange"
                        app:errorTextColor="@color/orange"
                        app:startIconDrawable="@drawable/ic_convertion_status">

                        <AutoCompleteTextView
                            android:id="@+id/etTagInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtRefferedPartiesID"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="" />



                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:id="@+id/layoutVerificationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Actual Information">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtVerificationInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:lines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:text="Submit Verification" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>



        <androidx.cardview.widget.CardView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="Verification Information"
            android:textSize="15sp"
            android:background="@color/gray_three"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/black"/>


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            app:boxStrokeErrorColor="@color/orange"
            app:endIconMode="clear_text"
            app:errorIconTint="@color/orange"
            app:errorTextColor="@color/orange"
            app:startIconDrawable="@drawable/baseline_search_24">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:gravity="center"
                android:hint="Verification Details" />
        </com.google.android.material.textfield.TextInputLayout>





    </LinearLayout>


    </androidx.cardview.widget.CardView>



    </LinearLayout>




</FrameLayout>