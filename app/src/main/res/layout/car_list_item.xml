<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:cardCornerRadius="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_weight="0.2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >

                <View
                    android:layout_weight="0.2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"/>


                <ImageView
                    android:layout_weight="0.5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:src="@drawable/map_forcar"/>

                <TextView
                    android:id="@+id/carBook_status"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.5"
                    android:text="Status : Canceled"
                    android:textStyle="bold"
                    android:textColor="@color/titan_theme_color"
                    android:gravity="center"/>



            </LinearLayout>



            <LinearLayout
                android:layout_weight="0.55"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/circle"/>

                    <TextView
                        android:id="@+id/carbook_fdatetime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="From date : 15 May,2024 | 02:00 pm"
                        android:layout_marginLeft="15dp"
                        android:textSize="13sp"/>
                </LinearLayout>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_weight="0.03"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:orientation="vertical">



                        <TextView
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:background="@color/gray_four"
                            android:layout_gravity="center"/>


                    </LinearLayout>

                    <!--                middle part text-->
                    <LinearLayout
                        android:layout_weight="0.9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/carbook_purpose"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:padding="5dp"
                            android:textSize="18sp"
                            android:text="This is a test purpose ."
                            />

                        <TextView
                            android:id="@+id/carbook_numOfUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Number of user : 4"
                            android:layout_marginLeft="5dp"
                            android:textSize="13sp"/>


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Driver info : "
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="20dp"
                            android:textStyle="bold"
                            android:textColor="@color/titan_theme_color"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/carbook_driverInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mr.x ( num : 01757193308)"
                            android:layout_marginLeft="5dp"
                            android:textStyle="bold"
                            android:textColor="@color/titan_theme_color"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/txtcarApproveAuth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Approve Authority"
                            android:layout_marginLeft="5dp"
                            android:textSize="11sp"
                            android:textColor="@color/green"
                            />


                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/car_chipGroup"
                            app:singleLine="false"
                            android:layout_marginRight="10dp"
                            android:layout_marginLeft="5dp"
                            app:singleSelection="true"/>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/circle_red"/>

                    <TextView
                        android:id="@+id/carbook_tdatetime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="To date : 15 May,2024 | 02:00 pm"
                        android:layout_marginLeft="15dp"
                        android:textSize="13sp"/>
                </LinearLayout>








            </LinearLayout>

        </LinearLayout>




    </LinearLayout>




</androidx.cardview.widget.CardView>