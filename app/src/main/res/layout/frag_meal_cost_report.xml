<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="56dp"
    tools:context=".UI.Fragment.Frag_Meal_Cost_Report">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <LinearLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutFromDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:layout_weight="1"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@drawable/baseline_calendar_month_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtFrDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:textSize="12sp"
                            android:hint="From Date"/>


                    </com.google.android.material.textfield.TextInputLayout>


                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.05"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutToDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:layout_weight="1"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@drawable/baseline_calendar_month_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtTDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:textSize="12sp"
                            android:hint="To Date"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Meal Cost"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <androidx.cardview.widget.CardView
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="55dp"
                    android:layout_marginRight="55dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:padding="10dp"
                        android:id="@+id/txtTotalPayable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="৳ 00"
                        android:textSize="24sp"/>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_weight="0.35"
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                     android:paddingTop="5dp"
                                android:orientation="horizontal">


                                <TextView
                                    android:textSize="12sp"
                                    android:layout_weight="0.8"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="Total Qty"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalMealQty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#898583"
                                android:padding="2dp"
                                android:textSize="20sp"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <View
                        android:layout_weight="0.02"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"/>

                    <androidx.cardview.widget.CardView
                        app:cardBackgroundColor="@color/card_color"
                        android:layout_weight="0.35"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                     >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="5dp"
                                android:orientation="horizontal">


                                <TextView
                                    android:textSize="12sp"
                                    android:layout_weight="0.8"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="Total Rate"
                                    android:gravity="center"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalMealrate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="৳ 00"
                                android:textColor="#898583"
                                android:padding="2dp"
                                android:textSize="20sp"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <View
                        android:layout_weight="0.03"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"/>

                    <androidx.cardview.widget.CardView
                        android:layout_weight="0.35"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/card_color">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                        >

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="5dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:textSize="12sp"
                                    android:layout_weight="0.8"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="Total Overhead"
                                    android:gravity="center"
                                    android:padding="2dp"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalOverHead"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="৳ 00"
                                android:textColor="#898583"
                                android:padding="2dp"
                                android:textSize="20sp"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <LinearLayout
            android:background="@color/titan_theme_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">


            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Date"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.01"
                android:background="#CCCCCC"/>

            <TextView
                android:textColor="@color/white"
                android:text="Status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:gravity="center"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.01"
                android:background="#CCCCCC"/>

            <TextView
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:gravity="center"
                android:text="Meal"/>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.01"
                android:background="#CCCCCC"/>

            <TextView
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Rate"/>


            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.01"
                android:background="#CCCCCC"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Overhead"/>
        </LinearLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_meal_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <include layout="@layout/shimmer_meal_cost"/>
                <include layout="@layout/shimmer_meal_cost"/>
                <include layout="@layout/shimmer_meal_cost"/>
                <include layout="@layout/shimmer_meal_cost"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMealList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            tools:listitem="@layout/meal_cost_item"/>
        <com.airbnb.lottie.LottieAnimationView android:id="@+id/noMealData" android:layout_width="160dp" android:layout_height="180dp" android:layout_gravity="center" android:layout_marginTop="80dp" android:visibility="gone" app:lottie_autoPlay="true" app:lottie_loop="false" app:lottie_rawRes="@raw/no_data"/>
    </LinearLayout>
</FrameLayout>