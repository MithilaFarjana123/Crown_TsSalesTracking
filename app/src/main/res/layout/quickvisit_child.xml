<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <ImageView
                    android:id="@+id/imgSiteImage"
                    android:scaleType="fitXY"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"/>

                <LinearLayout
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">




                    <LinearLayout
                        android:layout_marginLeft="9dp"
                        android:layout_weight="0.9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtCusName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Mr Trading International"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtParty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:drawableLeft="@drawable/ic_baseline_address"
                            android:gravity="center_vertical"
                            android:text="10:45AM"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtVisitDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:drawableLeft="@drawable/clock"
                            android:gravity="center_vertical"
                            android:text="10:45AM"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCustomerPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:drawableLeft="@drawable/baseline_smartphone_24"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgCusStatus"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="0.08"
                        android:padding="5dp" />


                </LinearLayout>




            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <TextView
            android:id="@+id/txtCount"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_red"
            android:layout_gravity="start"
            android:text="0/1"
            android:gravity="center"
            android:translationZ="10dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </FrameLayout>



</LinearLayout>