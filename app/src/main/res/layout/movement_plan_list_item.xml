<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_weight="0.3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:id="@+id/txtMovementNumber"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="20"
                android:layout_gravity="center"
                android:background="@drawable/circle_shape"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_margin="5dp"
                android:padding="5dp"
                android:textColor="@color/white"
                android:gravity="center"
                />




        </LinearLayout>



        <LinearLayout
            android:layout_weight="0.7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/titan_theme_color"/>


            <TextView
                android:id="@+id/txtRouteNa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sector 9-Abdullapur"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRouteDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Sector 9,Sector 10,Sector 11,Sector 12,Sector 13,Sector 14,Abdullapur"
                android:textSize="12sp" />

        </LinearLayout>





    </LinearLayout>


</LinearLayout>