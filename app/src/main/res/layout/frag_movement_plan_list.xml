<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_marginTop="56dp"
    tools:context=".UI.Fragment.Frag_Movement_Plan_List">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmpMovementL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/mov_approve_child_item_one" />


    </LinearLayout>


    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_margin="12dp"
        android:contentDescription="TODO"
        android:text="Submit Movement Plan"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/titan_theme_color"
        app:icon="@drawable/ic_check_green"
        app:iconTint="@color/white"
        app:tint="@color/white" />


</FrameLayout>