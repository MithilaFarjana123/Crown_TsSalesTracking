<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <LinearLayout
        android:background="#CCCCCC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.1"
            android:padding="5dp"
            android:src="@drawable/ic_shop" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:padding="8dp"
            android:text="Party Shop Info"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="20sp" />

    </LinearLayout>
    <!--        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"-->

    <!--OUTLET CATEGORY-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_status">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:id="@+id/txtOutletCategory"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Outlet Category" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--SHOP AREA-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_align_vertical">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:id="@+id/txtShopArea"
            android:focusable="false"
            android:inputType="numberDecimal"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Shop Area" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--Market Point-->
    <com.google.android.material.textfield.TextInputLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_thana">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:id="@+id/txtMarketPoint"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:background="@android:color/transparent"
            android:hint="Market Point" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--PARTY HOUSE 2-->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_smartphone">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:id="@+id/txtPartyPhone2"
            android:inputType="phone"
            android:background="@android:color/transparent"
            android:hint="Party Phone 2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baselin_user_color">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:id="@+id/txtManagerName"
            android:background="@android:color/transparent"
            android:hint="Manager Name" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_smartphone">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="phone"
            android:id="@+id/txtManagerPhone1"
            android:background="@android:color/transparent"
            android:hint="Manager Mobile 1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_smartphone">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:inputType="phone"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:id="@+id/txtManagerPhone2"
            android:hint="Manager Mobile 2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:boxStrokeErrorColor="@color/orange"
        app:endIconMode="clear_text"
        app:errorIconTint="@color/orange"
        app:errorTextColor="@color/orange"
        app:startIconDrawable="@drawable/ic_baseline_align_vertical">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:focusable="false"
            android:layout_height="wrap_content"
            android:id="@+id/txtShopFront"
            android:inputType="numberDecimal"
            android:background="@android:color/transparent"
            android:hint="Shop Front Length" />
    </com.google.android.material.textfield.TextInputLayout>


</LinearLayout>