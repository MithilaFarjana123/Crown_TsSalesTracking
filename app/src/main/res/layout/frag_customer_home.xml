<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layout_marginBottom="56dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Fragment.Frag_Customer_Home">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/imgRetailerHomeCover"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="fitXY"
            android:src="@drawable/shop_banner" />


        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/locationStatus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="start"
            android:layout_marginTop="-160dp"
            android:layout_marginBottom="120dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="gone"
            app:lottie_rawRes="@raw/live"/>

        <ImageView
            android:id="@+id/imgVerified"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:layout_marginTop="-160dp"
            android:layout_marginBottom="120dp"
            android:src="@drawable/ic_verified"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgRetailerSetCover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="-80dp"
            android:layout_marginBottom="50dp"
            android:clickable="true"
            android:src="@drawable/ic_camera_cover"
            tools:ignore="SpeakableTextPresentCheck,ImageContrastCheck,TouchTargetSizeCheck" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="-30dp"
            android:layout_marginRight="20dp"
            app:cardCornerRadius="8dp">

            <!--            app:cardBackgroundColor="#F8F8F8"-->

            <LinearLayout
                android:id="@+id/txtShopDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:orientation="horizontal"
                android:paddingTop="15dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtShopName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Testing Engineers"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtShopOwner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Propitor: ABdul Hamid Khan"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Address: East Goran, Khilgaon Dhaka 1219"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtShopMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Mobile: +8801234565443"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtShopCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Code: Re-123455"
                        android:textSize="14sp" />


                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.2"
                    android:padding="5dp"
                    android:src="@drawable/default_user_image"
                    android:visibility="gone" />


            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <include
            android:id="@+id/retailerDashboardChild"
            layout="@layout/retailer_dashboard_child" />


    </LinearLayout>

</FrameLayout>