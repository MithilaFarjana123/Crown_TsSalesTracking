<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseEditTextStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="colorPrimary">@color/titan_theme_color</item>
        <item name="colorPrimaryVariant">@color/titan_theme_color</item>
        <item name="colorControlHighlight">@color/titan_theme_color</item>
        <item name="colorAccent">@color/titan_theme_color</item>
        <item name="hintTextColor">@color/titan_theme_color</item>
        <item name="boxStrokeColor">@color/titan_theme_color</item>
        <item name="errorIconTint">@color/orange</item>
        <item name="android:textColorPrimary">#ABA6A6</item>
        <item name="android:backgroundTint">#ABA6A6</item>

        <item name="boxStrokeErrorColor">@color/orange</item>


    </style>

    <style name="MyCardView" parent="Widget.MaterialComponents.CardView">

        <item name="android:topLeftRadius">16dp</item>
        <item name="android:topRightRadius">16dp</item>
        <item name="android:bottomLeftRadius">0dp</item>
        <item name="android:bottomRightRadius">0dp</item>

    </style>


    <style name="CircularDeterminateProgressBar">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/progress_circle</item>
    </style>


    <style name="CalendarViewTextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#313231</item>
        <item name="android:textStyle">bold</item>

    </style>


    <style name="CalendarViewWeekDayTextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#B10C0C</item>
        <item name="android:textStyle">bold</item>
    </style>



    <style name="HolidayDateTextAppearance">
        <item name="android:textColor">#FF0000</item> <!-- Change the text color to red -->

    </style>

</resources>